// UniLab Pest Grammar (MATLAB-compatible)

WHITESPACE = _{ " " | "\t" | ("..." ~ (!NEWLINE ~ ANY)* ~ NEWLINE?) }
COMMENT = _{ "%" ~ (!NEWLINE ~ ANY)* }
hws = _{ " " | "\t" }

start = { SOI ~ separator* ~ (stmt_sep ~ separator*)* ~ stmt_no_sep? ~ EOI }

separator = { ";" | "," | NEWLINE }
stmt_sep = { statement ~ separator }
stmt_no_sep = { statement ~ separator? }

// Explicit word-bounded keywords so identifiers like `end_time`, `return_rate`,
// `for_idx`, `clear_flag`, `if_valid` are never misparsed as keywords.
kw_function  = @{ "function"  ~ !(ASCII_ALPHANUMERIC | "_") }
kw_end       = @{ "end"       ~ !(ASCII_ALPHANUMERIC | "_") }
kw_if        = @{ "if"        ~ !(ASCII_ALPHANUMERIC | "_") }
kw_elseif    = @{ "elseif"    ~ !(ASCII_ALPHANUMERIC | "_") }
kw_else      = @{ "else"      ~ !(ASCII_ALPHANUMERIC | "_") }
kw_for       = @{ "for"       ~ !(ASCII_ALPHANUMERIC | "_") }
kw_parfor    = @{ "parfor"    ~ !(ASCII_ALPHANUMERIC | "_") }
kw_while     = @{ "while"     ~ !(ASCII_ALPHANUMERIC | "_") }
kw_switch    = @{ "switch"    ~ !(ASCII_ALPHANUMERIC | "_") }
kw_case      = @{ "case"      ~ !(ASCII_ALPHANUMERIC | "_") }
kw_otherwise = @{ "otherwise" ~ !(ASCII_ALPHANUMERIC | "_") }
kw_try       = @{ "try"       ~ !(ASCII_ALPHANUMERIC | "_") }
kw_catch     = @{ "catch"     ~ !(ASCII_ALPHANUMERIC | "_") }
kw_global    = @{ "global"    ~ !(ASCII_ALPHANUMERIC | "_") }
kw_clear     = @{ "clear"     ~ !(ASCII_ALPHANUMERIC | "_") }
kw_return    = @{ "return"    ~ !(ASCII_ALPHANUMERIC | "_") }
kw_break     = @{ "break"     ~ !(ASCII_ALPHANUMERIC | "_") }
kw_continue  = @{ "continue"  ~ !(ASCII_ALPHANUMERIC | "_") }
kw_import    = @{ "import"    ~ !(ASCII_ALPHANUMERIC | "_") }
kw_export    = @{ "export"    ~ !(ASCII_ALPHANUMERIC | "_") }

statement = {
    function_def
    | if_stmt
    | for_stmt
    | parfor_stmt
    | while_stmt
    | switch_stmt
    | try_stmt
    | clear_stmt
    | global_stmt
    | return_stmt
    | break_stmt
    | continue_stmt
    | import_stmt
    | export_stmt
    | assignment
    | command_call
    | expression
}

assignment = { multi_assignment | single_assignment }
multi_assignment = { lhs_list ~ "=" ~ expression }
single_assignment = { postfix_expr ~ "=" ~ expression }

lhs_list = { "[" ~ (lhs_item ~ (","? ~ lhs_item)*)? ~ "]" }
lhs_item = { ignore_arg | postfix_expr }
ignore_arg = @{ "~" ~ !"=" }

if_stmt = { kw_if ~ expression ~ separator+ ~ block ~ elseif_clause* ~ else_clause? ~ kw_end }
elseif_clause = { kw_elseif ~ expression ~ separator+ ~ block }
else_clause = { kw_else ~ separator* ~ block }

for_stmt = { kw_for ~ identifier ~ "=" ~ expression ~ separator+ ~ block ~ kw_end }
parfor_stmt = { kw_parfor ~ identifier ~ "=" ~ expression ~ separator+ ~ block ~ kw_end }
while_stmt = { kw_while ~ expression ~ separator+ ~ block ~ kw_end }

switch_stmt = { kw_switch ~ expression ~ separator+ ~ case_clause* ~ otherwise_clause? ~ kw_end }
case_clause = { kw_case ~ expression ~ separator+ ~ block }
otherwise_clause = { kw_otherwise ~ separator* ~ block }

try_stmt = { kw_try ~ separator* ~ block ~ catch_clause? ~ kw_end }
catch_clause = { kw_catch ~ catch_var? ~ separator* ~ block }
catch_var = { identifier ~ &separator }

function_def = { kw_function ~ function_ret? ~ identifier ~ ("(" ~ func_params? ~ ")")? ~ separator* ~ block ~ kw_end }
function_ret = { (identifier | func_ret_list) ~ "=" }
func_ret_list = { "[" ~ (identifier ~ (","? ~ identifier)*)? ~ "]" }
func_params = { param_item ~ (","? ~ param_item)* }
param_item = { identifier | ignore_arg }

block = { (separator* ~ (!keyword_end ~ stmt_sep ~ separator*)* ~ (!keyword_end ~ stmt_no_sep)?) }
keyword_end = @{ ("elseif" | "else" | "case" | "otherwise" | "catch" | "end") ~ !(ASCII_ALPHANUMERIC | "_") }

clear_stmt = { kw_clear ~ ("(" ~ ")")? ~ identifier* }
global_stmt = { kw_global ~ identifier+ }
return_stmt = { kw_return }
break_stmt = { kw_break }
continue_stmt = { kw_continue }

import_stmt = { kw_import ~ import_path }
import_path = @{ (ASCII_ALPHA | "_") ~ (ASCII_ALPHANUMERIC | "_" | "." | "*")* }
export_stmt = { kw_export ~ identifier }

expression = { anonymous_func | logical_or }

logical_or = { logical_and ~ (or_op ~ logical_and)* }
or_op = { "||" | "|" }
logical_and = { comparison ~ (and_op ~ comparison)* }
and_op = { "&&" | "&" }
comparison = { range_expr ~ (comp_op ~ range_expr)* }

range_expr = {
    addition ~ (":" ~ addition ~ (":" ~ addition)?)?
}

addition = { multiplication ~ (add_op ~ multiplication)* }
multiplication = { unary ~ (mul_op ~ unary)* }
unary = { unary_op ~ unary | power }
power = { postfix_expr ~ (pow_op ~ unary)* }

postfix_expr = {
    atom ~ postfix_op*
}

postfix_op = {
    function_call
    | cell_indexing
    | transpose
    | attr_access
}

function_call = { "(" ~ call_args? ~ ")" }
cell_indexing = { "{" ~ call_args? ~ "}" }
transpose = { "'" | ".'" }
attr_access = { "." ~ identifier }

call_args = { arg_item ~ ("," ~ arg_item)* }
arg_item = { keyword_arg | expression | colon_arg }
colon_arg = { ":" }
keyword_arg = { identifier ~ "=" ~ expression }

atom = {
    number
    | string
    | function_handle
    | end_kw
    | identifier
    | "(" ~ expression ~ ")"
    | matrix
    | cell_array
}

end_kw = @{ "end" ~ !(ASCII_ALPHANUMERIC | "_") }

anonymous_func = { "@" ~ "(" ~ func_params? ~ ")" ~ expression }
function_handle = { "@" ~ qualified_name }

qualified_name = { identifier ~ ("." ~ identifier)* }

matrix = { "[" ~ (row | ";" | NEWLINE)* ~ "]" }
row = { expression ~ (","? ~ expression)* ~ ","? }

cell_array = { "{" ~ (row | ";" | NEWLINE)* ~ "}" }

cmd_arg = _{ string | number | identifier }
command_call = ${ identifier ~ hws+ ~ cmd_arg ~ (hws+ ~ cmd_arg)* ~ &(hws* ~ COMMENT? ~ (separator | EOI)) }

identifier = @{ !(keyword ~ !(ASCII_ALPHANUMERIC | "_")) ~ (ASCII_ALPHA | "_") ~ (ASCII_ALPHANUMERIC | "_")* }
keyword = @{
    "function" | "elseif" | "else" | "if" | "parfor" | "for" | "while" | "switch" | "case" | "otherwise" | "try" | "catch" | "global" | "clear" | "return" | "break" | "continue" | "import" | "export" | "end"
}

number = @{
    (("0x" | "0X") ~ (ASCII_HEX_DIGIT | "_")+ )
    | (("0b" | "0B") ~ (ASCII_BIN_DIGIT | "_")+ )
    | (ASCII_DIGIT+ ~ "." ~ !("*" | "/" | "\\" | "^" | "+" | "-" | "'") ~ ASCII_DIGIT* ~ (("e" | "E") ~ ("+" | "-")? ~ ASCII_DIGIT+)? ~ ("i" | "j")?)
    | ("." ~ ASCII_DIGIT+ ~ (("e" | "E") ~ ("+" | "-")? ~ ASCII_DIGIT+)? ~ ("i" | "j")?)
    | (ASCII_DIGIT+ ~ (("e" | "E") ~ ("+" | "-")? ~ ASCII_DIGIT+)? ~ ("i" | "j")?)
}

string = @{ ("'" ~ ("''" | (!"'" ~ ANY))* ~ "'") | ("\"" ~ ("\\" ~ ANY | (!"\"" ~ ANY))* ~ "\"") }

add_op = { ".+" | ".-" | "+" | "-" }
mul_op = { ".*" | "./" | ".\\" | "*" | "/" | "\\" }
pow_op = { ".^" | "^" }
unary_op = { "+" | "-" | "~" }
comp_op = { "==" | "~=" | ">=" | "<=" | ">" | "<" }
