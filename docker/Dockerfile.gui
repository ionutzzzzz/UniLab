# Dockerfile for Unilab (Full GUI with Web Terminal)
# Stage 1: Build Rust Core
FROM rust:1.85-slim AS rust-builder
RUN apt-get update && apt-get install -y --no-install-recommends \
    pkg-config \
    python3-dev \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY backend/Cargo.toml backend/Cargo.lock ./
COPY backend/unilab_core ./unilab_core
COPY backend/unilab_cli ./unilab_cli
RUN cargo build --release -p unilab_core

# Stage 2: Build Flutter Web
FROM debian:bookworm-slim AS flutter-builder
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl git unzip xz-utils libglu1-mesa \
    && rm -rf /var/lib/apt/lists/*
RUN git clone --depth 1 --branch stable https://github.com/flutter/flutter.git /usr/local/flutter
ENV PATH="/usr/local/flutter/bin:/usr/local/flutter/bin/cache/dart-sdk/bin:${PATH}"
WORKDIR /app
COPY frontend/ .
RUN flutter pub get && flutter build web --release --base-href /terminal/

# Stage 3: Production Python
FROM python:3.12-slim
WORKDIR /app

# Install system dependencies for scientific libraries (headless)
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libgl1 \
    libglib2.0-0 \
    libfontconfig1 \
    libxrender1 \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements and install
COPY backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy backend code
COPY backend/ ./backend/
# Copy built Rust library from builder stage
COPY --from=rust-builder /app/target/release/libunilab_core.so ./backend/core/unilab_rust_core.so
COPY --from=rust-builder /app/target/release/libunilab_core.so ./backend/core/engines/libunilab_core.so
# Copy Flutter Web build to be served by FastAPI under /terminal
COPY --from=flutter-builder /app/build/web/ ./backend/web/

# Set environment variables
ENV PYTHONPATH=/app
ENV UNILAB_WORKSPACE_ROOT=/app/workspaces
ENV UNILAB_API_SERVER=1
ENV MPLBACKEND=Agg
ENV QT_QPA_PLATFORM=offscreen

# Create workspaces directory
RUN mkdir -p /app/workspaces

# Expose port
EXPOSE 8000

# Single worker preserves in-memory UniLabCore session state
CMD ["gunicorn", "-w", "1", "-k", "uvicorn.workers.UvicornWorker", "backend.api.main:app", "--bind", "0.0.0.0:8000"]
